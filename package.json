{
  "name": "fortran-2026-computing",
  "version": "1.0.0",
  "private": true,
  "description": "Materi dan alat Prediktor (Dua Cara Belajar) Computing Laboratory untuk FORTRAN 2026",
  "scripts": {
    "serve": "node scripts/serve.mjs site 8080",
    "test": "npm run test:unit && npm run lint:text && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "lint:text": "node scripts/lint-text.mjs",
    "qr": "node scripts/make-qr.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "qrcode": "1.5.4"
  }
}
